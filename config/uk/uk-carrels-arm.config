CONFIG_PLAT_CARRELS=y
CONFIG_ARCH_ARM_64=y
CONFIG_UKPLAT_CPU_MAXCOUNT=1
CONFIG_LIBUKBOOT_MAINTHREAD=y
CONFIG_LIBUKBOOT_MAINTHREAD_NOHALT=y

CONFIG_LIBVFSCORE=y
CONFIG_LIBVFSCORE_AUTOMOUNT_UP=y
CONFIG_LIBVFSCORE_AUTOMOUNT_CI=y
CONFIG_LIBVFSCORE_AUTOMOUNT_CI_EINITRD=y

CONFIG_LIBRAMFS=y
CONFIG_LIBUKCPIO=y

CONFIG_LIBPOSIX_TIME=y
